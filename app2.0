// main.jsx
import React from 'react';
import ReactDOM from 'react-dom/client';
import App from './App';
import './index.css';

ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>
);

// App.jsx
import React from 'react';
import { BrowserRouter as Router, Routes, Route } from 'react-router-dom';
import Jobs from './pages/Jobs';
import Inventory from './pages/Inventory';
import Invoices from './pages/Invoices';
import Dashboard from './pages/Dashboard';

function App() {
  return (
    <Router>
      <Routes>
        <Route path="/" element={<Dashboard />} />
        <Route path="/jobs" element={<Jobs />} />
        <Route path="/inventory" element={<Inventory />} />
        <Route path="/invoices" element={<Invoices />} />
      </Routes>
    </Router>
  );
}

export default App;

// pages/Dashboard.jsx
import React from 'react';

function Dashboard() {
  return <div className="p-4 text-xl font-bold">Welcome to Mechanic Shop Manager</div>;
}

export default Dashboard;

// pages/Jobs.jsx
import React from 'react';

function Jobs() {
  return <div className="p-4">Job Scheduling Coming Soon...</div>;
}

export default Jobs;

// pages/Inventory.jsx
import React from 'react';

function Inventory() {
  return <div className="p-4">Inventory Tracking Coming Soon...</div>;
}

export default Inventory;

// pages/Invoices.jsx
import React from 'react';

function Invoices() {
  return <div className="p-4">Invoice Management Coming Soon...</div>;
}

export default Invoices;

